# URL publique du site (sitemap, hreflang, Open Graph)
NEXT_PUBLIC_SITE_URL=https://axiona.example.com

# Webhook qui reçoit les demandes du formulaire (n8n, Make, Zapier...)
# Laisser vide : le formulaire propose alors d'envoyer la demande par WhatsApp.
CONTACT_WEBHOOK_URL=

# Optionnel : secret envoyé dans l'en-tête X-Axiona-Secret pour authentifier l'appel du webhook
CONTACT_WEBHOOK_SECRET=
